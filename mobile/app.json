{
  "expo": {
    "name": "Muze",
    "slug": "muze",
    "scheme": "muze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aryan.muze"
    },
    "android": {
      "package": "com.aryan.muze",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Muze to access your photos to set a profile picture."
        }
      ]
    ]
  }
}
